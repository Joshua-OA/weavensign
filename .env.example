# Copy to `.env` in the repo root — the server auto-loads it on startup (shell env wins).
# Values may be quoted ("...") — quotes are stripped.
FIGMA_TOKEN=
PENPOT_TOKEN=
FIGMA_NEW_TOKEN=

# Figma OAuth (browser login) — create a free app at https://www.figma.com/developers/apps,
# add redirect URL http://localhost:55887/callback, then set these for `setup`:
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
# FIGMA_OAUTH_PORT=55887

# Set to 1 to print the authorize URL instead of opening a browser (CI/headless):
# WEAVENSIGN_NO_OPEN=1
