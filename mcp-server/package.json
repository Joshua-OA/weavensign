{
  "name": "@weavensign/mcp-server",
  "version": "0.1.0",
  "description": "MCP server exposing the Figma/Penpot adapters, normalization layer, and renderers as callable tools",
  "license": "GPL-3.0",
  "type": "module",
  "bin": {
    "weavensign": "./dist/server.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "prettier": "3.9.5",
    "svgo": "4.0.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "20.14.15",
    "@weavensign/adapter-figma": "0.1.0",
    "@weavensign/adapter-penpot": "0.1.0",
    "@weavensign/normalization": "0.1.0",
    "@weavensign/renderer-html-css": "0.1.0",
    "@weavensign/renderer-jsx-tsx": "0.1.0",
    "@weavensign/renderer-svg": "0.1.0",
    "@weavensign/schema": "0.2.0",
    "tsup": "8.5.1",
    "typescript": "5.5.4",
    "vitest": "^4.0.0",
    "zod": "4.4.3"
  }
}
